# ==============================================================================
# Snitch Frontend — Environment Variables
# ==============================================================================
# In local development:
#   Leave VITE_API_URL empty or set to /api to use the Vite dev server proxy (http://localhost:3000).
#
# In production (e.g., Render Static Site deployment):
#   Set VITE_API_URL to the URL of your deployed backend service.
#   Example:
#   VITE_API_URL=https://snitch-server.onrender.com/api
# ==============================================================================
VITE_API_URL=http://localhost:3000
